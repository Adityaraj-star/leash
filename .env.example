# --- Leash server (required) ---
LEASH_ADMIN_TOKEN=<64 random hex chars>
LEASH_AGENT_TOKEN=<a different 64 random hex chars>

# --- PayPal sandbox (required for real mode) ---
PAYPAL_CLIENT_ID=<sandbox client id of the app-owner app>
PAYPAL_CLIENT_SECRET=<sandbox secret>
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Public address (use the Render https URL once deployed) ---
LEASH_PUBLIC_URL=

# --- Demo shops (cmd/shops) ---
LEGIT_SECRET=<must equal legitgifts delivery_secret in merchants.json>
SHADY_SECRET=<anything>
LEGIT_ADMIN_PASSWORD=<shop back-office password>
SHADY_ADMIN_PASSWORD=<anything>

# --- Agent simulator (scripts/agent-sim.mjs) ---
LEASH_URL=http://127.0.0.1:8787
SHOP_URL=http://localhost:9001
MERCHANT_ID=legitgifts
MERCHANT_SECRET=<same value as LEGIT_SECRET>

# --- AI (optional) ---
GROQ_API_KEY=
